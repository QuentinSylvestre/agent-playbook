{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "{{USER_HOME}}/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js"
      ],
      "disabled": true,
      "autoApprove": [
        "browser_navigate",
        "browser_snapshot",
        "browser_evaluate",
        "browser_click",
        "browser_run_code_unsafe",
        "browser_close"
      ]
    }
  }
}
