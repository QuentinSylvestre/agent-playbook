{
  "description": "The state file deleted outside the scripts is the incident: exit 3, `incident` true, the backup path named.",
  "now": "2026-10-12T12:00:00Z",
  "write": {
    "repo/.gitignore": "memory/.dream-journal.jsonl\n",
    "repo/memory/MEMORY.md": "# Memory\n",
    "repo/memory/.dream-state.json": "{\"state\": \"orient\"}\n"
  },
  "git": [
    "repo"
  ],
  "steps": [
    {
      "argv": [
        "dirty",
        "--repo",
        "{ROOT}/repo"
      ],
      "exit": 0
    },
    {
      "delete": [
        "repo/memory/.dream-state.json"
      ]
    },
    {
      "argv": [
        "drift",
        "--phase",
        "gather"
      ],
      "exit": 3,
      "stdout_contains": [
        "INCIDENT: state file deleted"
      ],
      "files": {
        "sweep/drift-gather.json": {
          "incident": true,
          "entries": [
            {
              "kind": "incident",
              "what": "state file",
              "change": "deleted",
              "path": "{ROOT}/repo/memory/.dream-state.json"
            }
          ]
        }
      }
    }
  ]
}
