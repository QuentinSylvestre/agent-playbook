  "git": [
    "repo"
  ],
  "write": {
    "repo/memory/.dream-state.json": "{\n  \"schema_version\": 3,\n  \"last_run\": \"2026-10-01T00:00:00Z\",\n  \"projects\": {\n    \"{ROOT}/proj/alpha\": {\n      \"last_analyzed\": \"2026-10-01T00:00:00Z\"\n    },\n    \"{ROOT}/proj/beta\": {\n      \"last_analyzed\": \"2026-10-01T00:00:00Z\"\n    }\n  },\n  \"rejected_lessons\": [],\n  \"outcome_tags\": [],\n  \"episodic_ledger\": [],\n  \"cost_records\": [],\n  \"model_routing\": {},\n  \"deferred_sessions\": {},\n  \"quiet_sweeps\": {\n    \"projects\": {\n      \"{ROOT}/proj/alpha\": 2,\n      \"{ROOT}/proj/beta\": 2\n    }\n  }\n}\n"
  },
  "manifest": [],
