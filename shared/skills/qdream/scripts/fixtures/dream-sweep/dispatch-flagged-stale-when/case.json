        "--repo",
        "{ROOT}/repo"
      ],
      "exit": 0
    },
    {
      "argv": [
        "dispatch",
        "--confirmed",
        "orient.json"
      ],
      "exit": 0,
      "files": {
        "sweep/dispatch.json": {
          "agents": [
            {
              "label": "A01",
